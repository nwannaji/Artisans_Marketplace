# ===========================================
# Django Backend — Production Environment
# ===========================================
# NEVER commit the real .env file to source control!
#
# For Render deployment:
#   Set these as Environment Variables in the Render Dashboard
#   (Dashboard → Your Service → Environment → Add Env Var)
# ===========================================

# ── Security ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_STRING

# Set to False in production!
DEBUG=False

# Comma-separated list of allowed hostnames (no spaces)
# For Render: use your Render service URL, e.g. fixit-api.onrender.com
ALLOWED_HOSTS=fixit-api.onrender.com

# ── Database (Neon) ─────────────────────────────────────
# Neon → Dashboard → Project → Connection Details → Connection string
# Neon provides both pooled (port 5432 via pgbouncer) and direct connections.
# For Django + gunicorn, the pooled connection string is recommended:
# Example: postgresql://neondb_owner:YOUR_PASSWORD@ep-solitary-rice-29566058.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-solitary-rice-29566058.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed origins (no spaces)
# Add your Flutter app's origin if you host a web version too
CORS_ALLOWED_ORIGINS=https://fixit-api.onrender.com

# ── SMS ────────────────────────────────────────────────
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_NAME=

# ── Google Maps ────────────────────────────────────────
GOOGLE_MAPS_API_KEY=YOUR_RESTRICTED_GOOGLE_MAPS_KEY

# ── Render-specific ────────────────────────────────────
# Render auto-sets PORT — no need to set it manually
# PORT=10000