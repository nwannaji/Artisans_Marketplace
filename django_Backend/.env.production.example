# ===========================================
# Django Backend — Production Environment
# ===========================================
# Copy this file to .env on your production server.
# NEVER commit the real .env file to source control!

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_STRING

# Set to False in production!
DEBUG=False

# Comma-separated list of allowed hostnames (no spaces)
ALLOWED_HOSTS=api.yourdomain.com,your-server-ip

# --- Database ---
DB_NAME=artisan_services_db
DB_USER=artisan_user
DB_PASSWORD=REPLACE_WITH_A_SECURE_DATABASE_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# --- CORS ---
# Comma-separated list of allowed origins (no spaces)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Paystack (use LIVE keys, not test keys) ---
PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_LIVE_SECRET_KEY
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_WITH_YOUR_LIVE_PUBLIC_KEY
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://api.yourdomain.com/api/payments/callback/

# --- SMS (optional) ---
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_NAME=

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=YOUR_RESTRICTED_GOOGLE_MAPS_KEY