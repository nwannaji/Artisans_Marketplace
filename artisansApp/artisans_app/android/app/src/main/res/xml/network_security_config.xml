<?xml version="1.0" encoding="utf-8"?>
<!-- Production network security config: HTTPS-only with localhost for debug builds.
     The debug override (allowing cleartext to emulator IPs) is in
     res/xml/network_security_config_debug.xml, which is only used in debug builds.
     See AndroidManifest.xml debugOnly override for details. -->
<network-security-config>
    <!-- Base: enforce HTTPS for all connections -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Production backend: HTTPS only -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">onrender.com</domain>
    </domain-config>

    <!-- Debug: allow cleartext to emulator localhost for development.
         This is needed because Android emulators access the host machine
         via 10.0.2.2 and physical devices on the same network need localhost.
         In release builds, Flutter's .env file points to the HTTPS production URL,
         so these cleartext rules are never triggered. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>