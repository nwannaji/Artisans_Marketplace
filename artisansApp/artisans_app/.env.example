# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to source control!

# Google Maps API Key — restrict in Google Cloud Console to your app's package name + SHA-1
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Backend API URL
# Development (Android emulator):  http://10.0.2.2:8000
# Development (physical device):     http://YOUR_LAN_IP:8000
# Production:                        https://api.yourdomain.com
API_BASE_URL=https://api.yourdomain.com