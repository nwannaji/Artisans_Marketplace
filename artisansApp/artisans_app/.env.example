# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to source control!

# Google Maps API Key — restrict in Google Cloud Console to your app's
# package name (com.fixit.ng) and SHA-1 signing key fingerprint.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Backend API URL
# Development (Android emulator):  http://10.0.2.2:8000
# Development (physical device):     http://YOUR_LAN_IP:8000
# Production (Render):               https://fixit-api-lsyh.onrender.com
API_BASE_URL=https://fixit-api-lsyh.onrender.com

# WebSocket URL for real-time chat
# Development (Android emulator):  ws://10.0.2.2:8000/ws/chat/
# Development (physical device):     ws://YOUR_LAN_IP:8000/ws/chat/
# Production (Render):               wss://fixit-api-lsyh.onrender.com/ws/chat/
WS_BASE_URL=wss://fixit-api-lsyh.onrender.com/ws/chat/